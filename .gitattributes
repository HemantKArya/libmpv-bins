# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force LF on shell scripts, env configs, and workflows
*.sh text eol=lf
*.env text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
